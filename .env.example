# Copy to .env and fill in. .env is git-ignored. Never paste these keys into chat or commit them.

# LLM provider key (OpenRouter / Cloudflare / Anthropic / any OpenAI-compatible service)
LLM_API_KEY=

# OKX API credentials. For mode="demo" use keys created under OKX "Demo Trading" (they are separate).
# For live: create a key with *Trade* permission only. Do NOT enable Withdraw. Restrict it to your IP.
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=

# Required to run mode="live". Leave blank until you have run paper AND demo for a while.
# To arm live trading, set it to exactly:  I-ACCEPT-REAL-MONEY-RISK
AEON_CONFIRM_LIVE=

# Discord alerts ([notify] enabled = true in config.toml). Channel settings -> Integrations -> Webhooks
# -> New Webhook -> Copy Webhook URL, paste it here. `python -m aeon --check` posts a test message.
DISCORD_WEBHOOK_URL=
